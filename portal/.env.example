# Portal API upstream; only the reverse proxy should be publicly reachable.
# Local development API upstream. Production should set this to the trusted local KGE proxy.
PORTAL_API_TARGET=http://host.docker.internal:8000

# Production: replace these example hosts with the HTTPS hostnames routed by the ingress.
VITE_KNOWLEDGE_URL=https://kge.example.com/chat
VITE_EVALUATION_URL=https://evaluation.example.com/datasets
VITE_SKILLHUB_URL=https://skillhub.example.com/

# OAuth2 Proxy / Keycloak confidential gateway client.
PORTAL_PUBLIC_ORIGIN=https://portal.example.com
OIDC_ISSUER=https://sso.example.com/realms/jack
GATEWAY_CLIENT_SECRET=copy-from-deploy-keycloak-env
OAUTH2_PROXY_COOKIE_SECRET=generate-a-unique-random-value
SSO_COOKIE_DOMAIN=.example.com
