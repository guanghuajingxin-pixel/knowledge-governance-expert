# Docker full-mode env (compose injects via env_file: .env.docker).
# Uses Docker service names so containers resolve infra on the dev-network.
DATABASE_URL=postgresql+asyncpg://dev:dev123456@dev-postgres:5432/dev_db
REDIS_URL=redis://:dev123456@dev-redis:6379/0
ES_HOST=http://dev-elasticsearch:9200
MINIO_ENDPOINT=dev-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
KKFV_URL=http://dev-kkfileview:8012
KB_API_INTERNAL_URL=http://kb-api:8000
JWT_SECRET=kb-mvp-dev-secret
# 服务间内部令牌（kb-api 校验 sidecar 内部接口调用；生产请更换）
KB_INTERNAL_TOKEN=kge-internal-dev-token
# kb-api 访问 DeerFlow 2.0 QA sidecar 的地址（compose 服务名）
DEERFLOW_SERVICE_URL=http://deerflow:2027
# Optional - empty = fallbacks (chat returns friendly msg, MinerU uses local txt/md/csv path)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
MINERU_API_KEY=
# 向量/重排模型全部外接（容器内不加载本地模型）；留空 = 本地 RAG 检索/入库不可用 + 跳过重排
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
