        </mxCell>
        <mxCell id="u5" value="进入 /chat&#10;创建 KB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-user">
          <mxGeometry x="1220" y="70" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="GET /auth/dingtalk-config&#10;判断 qr_login_enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="40" y="70" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="加载 DingTalk QR SDK&#10;渲染二维码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="240" y="70" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="/login/callback&#10;拿到 ?code=xxx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="420" y="70" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="POST /auth/dingtalk-login&#10;{auth_code}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="600" y="70" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="must_set_password=true&#10;→ 跳 /onboarding/set-password" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="lane-web">
          <mxGeometry x="800" y="55" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w6" value="POST /auth/set-password&#10;{new_password, confirm}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="1020" y="70" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="存新 JWT&#10;router.push(/chat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="1240" y="70" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w8" value="POST /knowledge-bases&#10;owner_id=当前用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-web">
          <mxGeometry x="1420" y="70" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="dingtalk-login 处理器&#10;调钉钉换 union_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="600" y="50" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="resolve_user(corp_id, dt_userid)&#10;查 DingtalkBinding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="600" y="110" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="新建分支：&#10;User(must_change_password=true,&#10;password_hash=random,&#10;role=viewer) + Binding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="lane-api">
          <mxGeometry x="840" y="105" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="签发 JWT&#10;payload={sub, role, dtu, mcp:true}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="1080" y="110" width="200" height="40" as="geometry" />
        </mxCell>
