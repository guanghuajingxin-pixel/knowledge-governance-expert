        <mxCell id="t1" value="POST /v1.0/oauth2/userAccessToken&#10;+ GET /v1.0/contact/users/me&#10;→ 返回 union_id, userid, name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-dt">
          <mxGeometry x="600" y="50" width="240" height="60" as="geometry" />
