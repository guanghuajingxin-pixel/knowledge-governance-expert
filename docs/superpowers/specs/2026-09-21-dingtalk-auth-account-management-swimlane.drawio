        <mxCell id="a6" value="写 audit_log&#10;action=self_set_password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="1240" y="50" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="KB 创建&#10;owner_id=principal.sub" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="1420" y="50" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="enqueue&#10;sync_kb.delay(kb_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="lane-api">
          <mxGeometry x="1620" y="50" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="INSERT users&#10;INSERT dingtalk_bindings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff" vertex="1" parent="lane-db">
          <mxGeometry x="860" y="50" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="UPDATE users&#10;SET password_hash, must_change_password=false,&#10;password_updated_at=now()" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff" vertex="1" parent="lane-db">
          <mxGeometry x="1080" y="50" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="INSERT knowledge_bases&#10;owner_id=新用户" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff" vertex="1" parent="lane-db">
          <mxGeometry x="1420" y="50" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="SELECT KB.owner_id →&#10;DingtalkBinding.dt_unionid" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff" vertex="1" parent="lane-db">
          <mxGeometry x="1640" y="50" width="200" height="60" as="geometry" />
