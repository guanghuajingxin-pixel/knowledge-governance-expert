  <diagram name="管理员重置密码与解绑" id="page-admin">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="alane-admin" value="管理员 (王五)" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alane-user" value="目标用户 (李四)" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="1520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alane-web" value="前端 Web" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1520" height="140" as="geometry" />
        </mxCell>
        <mxCell id="alane-api" value="kb-api" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="alane-db" value="PostgreSQL" style="swimlane;html=1;startSize=30;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1520" height="160" as="geometry" />
        </mxCell>

        <mxCell id="au1" value="进入 /admin/users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-admin">
          <mxGeometry x="40" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="au2" value="点击行操作&#10;「重置密码」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-admin">
          <mxGeometry x="220" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="au3" value="弹窗输入&#10;临时密码 + 勾选&#10;「强制下次改密」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-admin">
          <mxGeometry x="400" y="55" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="au4" value="钉钉私聊&#10;告知临时密码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-admin">
          <mxGeometry x="820" y="60" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="au5" value="解绑钉钉&#10;（换岗/离职）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-admin">
          <mxGeometry x="1180" y="60" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bu1" value="用 dd_{userid}&#10;+ 临时密码登录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-user">
          <mxGeometry x="820" y="60" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bu2" value="被强制跳&#10;/onboarding/set-password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc" vertex="1" parent="alane-user">
          <mxGeometry x="1000" y="60" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="bw1" value="POST /api/v1/users/{id}&#10;{password, must_change_password:true}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-web">
          <mxGeometry x="400" y="50" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bw2" value="DELETE /api/v1/users/{id}/dingtalk-binding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-web">
          <mxGeometry x="1120" y="50" width="280" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ba1" value="require_role(admin)&#10;校验最后一名 super_admin 保护" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-api">
          <mxGeometry x="400" y="40" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ba2" value="bcrypt.hash_password&#10;更新 User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-api">
          <mxGeometry x="400" y="100" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ba3" value="audit.write(&#10;  actor=admin,&#10;  action=admin_reset_password,&#10;  target=user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-api">
          <mxGeometry x="660" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ba4" value="require_role(admin)&#10;+ 保护最后一名 super_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff" vertex="1" parent="alane-api">
          <mxGeometry x="1120" y="40" width="240" height="50" as="geometry" />
        </mxCell>
