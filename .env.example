DATABASE_URL=postgresql+asyncpg://dev:dev123456@127.0.0.1:5432/dev_db
REDIS_URL=redis://:dev123456@127.0.0.1:6379/0
ES_HOST=http://127.0.0.1:9200
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
KKFV_URL=http://127.0.0.1:8012
JWT_SECRET=kb-mvp-dev-secret
# 文档解析：本地 MinerU 引擎（scripts/start-mineru.sh，默认 127.0.0.1:2028）。
# 留空/删除则仅在配置了 MINERU_API_KEY 时走 MinerU 云 API；office 文档另有 python-pptx/docx 即时解析兜底。
MINERU_LOCAL_URL=http://127.0.0.1:2028
# MinerU 云 API Key（本地引擎未运行时的降级通道，可留空）
MINERU_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
# Dify 知识库（智能问答 Agent 使用；Service API 端点需含端口与 /v1）
DIFY_BASE_URL=http://127.0.0.1:8088/v1
DIFY_API_KEY=
DIFY_DATASET_IDS=
# 智能问答 DWS 兜底（留空时从服务进程 PATH 查找新版 dws）
DWS_BIN=
# 显式绑定平台用户 UUID 到 dws profile；不填写时仅超级管理员可用当前组织账号
QA_DWS_USER_PROFILES={}
# 治理标准页使用的钉钉 AI 多维表。留空时使用内置《杰克知识管理规范》；
# 部署到其他租户或替换规范表时，填写目标多维表 URL 中的 baseId / sheetId。
DINGTALK_STANDARDS_BASE_ID=
DINGTALK_STANDARDS_SHEET_ID=

# 目录同步：整任务硬超时、单次导出超时、Dify 索引等待上限（秒）
SYNC_RUN_TIMEOUT_SECONDS=1800
SYNC_EXPORT_TIMEOUT_SECONDS=360
SYNC_INDEXING_TIMEOUT_SECONDS=600
# 等待索引成功后再记为同步成功
SYNC_DIFY_WAIT_INDEXING=true
